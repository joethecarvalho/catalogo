<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
  <div>
    <h2 class="h4 mb-1">{{#if somenteAbertas}}Inscrições Abertas{{else}}Todas as Oficinas{{/if}}</h2>
    <p class="text-muted mb-0">Gerencie as oficinas e acompanhe as inscrições.</p>
  </div>
  <a class="btn btn-primary" href="/oficinas/nova">+ Nova oficina</a>
</div>

<section class="row g-3 mb-4" aria-label="Resumo do catálogo">
  <div class="col-6 col-lg-3"><div class="card summary-card h-100"><div class="card-body"><div class="text-muted small">Total de oficinas</div><div class="fs-3 fw-semibold">{{resumo.total}}</div></div></div></div>
  <div class="col-6 col-lg-3"><div class="card summary-card h-100"><div class="card-body"><div class="text-muted small">Inscrições abertas</div><div class="fs-3 fw-semibold text-success">{{resumo.abertas}}</div></div></div></div>
  <div class="col-6 col-lg-3"><div class="card summary-card h-100"><div class="card-body"><div class="text-muted small">Inscrições encerradas</div><div class="fs-3 fw-semibold text-secondary">{{resumo.encerradas}}</div></div></div></div>
  <div class="col-6 col-lg-3"><div class="card summary-card h-100"><div class="card-body"><div class="text-muted small">Carga horária aberta</div><div class="fs-3 fw-semibold text-primary">{{resumo.cargaHorariaAbertas}} h</div></div></div></div>
</section>

<div class="d-flex flex-wrap gap-2 mb-3">
  <a class="btn btn-sm {{#unless somenteAbertas}}btn-primary{{else}}btn-outline-primary{{/unless}}" href="/">Todas as Oficinas</a>
  <a class="btn btn-sm {{#if somenteAbertas}}btn-primary{{else}}btn-outline-primary{{/if}}" href="/abertas">Inscrições Abertas</a>
</div>

{{#if mensagemVazia}}
  <div class="alert alert-info">
    {{mensagemVazia}}
    {{#if (eq resumo.total 0)}} <a href="/oficinas/nova" class="alert-link">Cadastre a primeira oficina.</a>{{/if}}
  </div>
{{else}}
  <div class="table-responsive">
    <table class="table table-hover table-bordered align-middle bg-white">
      <thead class="table-primary text-center">
        <tr><th>Título</th><th>Carga horária</th><th>Inscrições</th><th>Ações</th></tr>
      </thead>
      <tbody>
        {{#each oficinas}}
        <tr>
          <td class="fw-semibold">{{this.titulo}}</td>
          <td class="text-center">{{this.cargaHoraria}} h</td>
          <td class="text-center">
            {{#if this.inscricoesAbertas}}<span class="badge text-bg-success">Abertas</span>{{else}}<span class="badge text-bg-secondary">Encerradas</span>{{/if}}
          </td>
          <td>
            <div class="d-flex flex-wrap justify-content-center gap-1">
              <a class="btn btn-sm btn-outline-primary" href="/oficinas/{{this.id}}">Consultar</a>
              <a class="btn btn-sm btn-outline-secondary" href="/oficinas/{{this.id}}/editar">Editar</a>
              <button class="btn btn-sm btn-outline-danger" type="button"
                data-bs-toggle="modal" data-bs-target="#modalExcluir"
                data-oficina-id="{{this.id}}" data-oficina-titulo="{{this.titulo}}">Excluir</button>
              <form method="post" action="/oficinas/{{this.id}}/alternar">
                <button class="btn btn-sm {{#if this.inscricoesAbertas}}btn-outline-warning{{else}}btn-outline-success{{/if}}" type="submit">
                  {{#if this.inscricoesAbertas}}Encerrar{{else}}Reabrir{{/if}}
                </button>
              </form>
            </div>
          </td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
{{/if}}

<div class="modal fade" id="modalExcluir" tabindex="-1" aria-labelledby="modalExcluirLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title" id="modalExcluirLabel">Confirmar exclusão</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div>
      <div class="modal-body">Deseja realmente excluir a oficina <strong id="tituloOficinaExcluir"></strong>?</div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
        <form id="formExcluir" method="post"><button type="submit" class="btn btn-danger">Confirmar</button></form>
      </div>
    </div>
  </div>
</div>
