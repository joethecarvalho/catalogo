<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="card shadow-sm">
      <div class="card-body p-4">
        <h2 class="h4 mb-4">{{title}}</h2>
        {{#if erros}}
          <div class="alert alert-danger"><strong>Verifique os campos:</strong><ul class="mb-0 mt-2">{{#each erros}}<li>{{this}}</li>{{/each}}</ul></div>
        {{/if}}
        <form method="post" action="{{acao}}">
          <div class="mb-3">
            <label for="titulo" class="form-label">Título da oficina</label>
            <input class="form-control" type="text" id="titulo" name="titulo" maxlength="120" required value="{{oficina.titulo}}">
          </div>
          <div class="mb-3">
            <label for="responsavel" class="form-label">Pessoa responsável</label>
            <input class="form-control" type="text" id="responsavel" name="responsavel" maxlength="120" required value="{{oficina.responsavel}}">
          </div>
          <div class="mb-3">
            <label for="descricao" class="form-label">Descrição da atividade</label>
            <textarea class="form-control" id="descricao" name="descricao" rows="5" required>{{oficina.descricao}}</textarea>
          </div>
          <div class="mb-4">
            <label for="cargaHoraria" class="form-label">Carga horária total (horas)</label>
            <input class="form-control" type="number" id="cargaHoraria" name="cargaHoraria" min="1" max="40" step="1" required value="{{oficina.cargaHoraria}}">
            <div class="form-text">Informe um número inteiro entre 1 e 40.</div>
          </div>
          <div class="d-flex gap-2">
            <button class="btn btn-primary" type="submit">{{botao}}</button>
            {{#if editando}}
              <a class="btn btn-outline-secondary" href="/oficinas/{{oficina.id}}">Cancelar</a>
            {{else}}
              <a class="btn btn-outline-secondary" href="/">Cancelar</a>
            {{/if}}
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
