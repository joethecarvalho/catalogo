<div class="row justify-content-center">
  <div class="col-lg-9">
    <div class="card shadow-sm mb-4">
      <div class="card-body p-4">
        <h2 class="h4 mb-3">Pesquisa de Oficinas</h2>
        <form method="post" action="/pesquisa">
          <label for="termo" class="form-label">Título da oficina</label>
          <div class="input-group">
            <input class="form-control" type="search" id="termo" name="termo" value="{{termo}}" placeholder="Digite parte do título..." required>
            <button class="btn btn-primary" type="submit">Pesquisar</button>
          </div>
        </form>
      </div>
    </div>

    {{#if pesquisado}}
      <h3 class="h5 mb-3">Resultado para: <span class="text-primary">“{{termo}}”</span></h3>
      {{#if resultados.length}}
        <div class="list-group">
          {{#each resultados}}
            <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" href="/oficinas/{{this.id}}">
              {{this.titulo}} <span class="badge text-bg-light">{{this.cargaHoraria}} h</span>
            </a>
          {{/each}}
        </div>
      {{else}}
        <div class="alert alert-warning">Nenhuma oficina encontrada para o termo informado.</div>
      {{/if}}
    {{else}}
      <div class="alert alert-info">Digite um termo no campo acima para pesquisar oficinas pelo título.</div>
    {{/if}}
  </div>
</div>
